# =============================================================================
# queandabuscando — every variable the app reads is listed here.
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Database (Supabase project of queandabuscando, NOT cuadrecaja's) --------
# Pooled connection (Supavisor, transaction mode). Used by the app at runtime.
# Transaction mode means no query may run on the global client inside a
# $transaction — batch into a single round-trip instead.
# Local (docker compose up -d):
#   postgresql://postgres:postgres@localhost:5433/queandabuscando
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2"
# Direct connection. Used only by migrations and introspection (DDL cannot run
# through the pooler). Configured in prisma.config.ts.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (shopper auth + image storage) --------------------------------
# Local (docker compose up -d): ONE gateway (`supabase-gateway`) serving BOTH
# the Storage emulator AND the Auth emulator (F-028) — the real Supabase
# Storage API and the real Supabase Auth API, at /storage/v1/* and /auth/v1/*
# of this SAME origin, exactly like Kong does in hosted Supabase. Only email
# access is verifiable end to end locally; Google/Facebook only up to the
# outbound redirect, and Apple is not even that (see .agent/specs/F-028/spec.md
# § Hasta dónde llega esto). Their credentials are NOT in this file and never
# should be — anything key-shaped committed here teaches the next person to
# paste a real key in the same slot. Generate your own, unique to your machine:
#
#   node scripts/storage-dev-keys.mjs --write
#   docker compose up -d --force-recreate storage supabase-gateway auth
#
# That writes STORAGE_JWT_SECRET (read by the emulators, not by the app) plus the
# two keys below into .env, which is gitignored. `docker compose` reads the same
# file, so the app and the emulators agree without either value living in git.
#
# If you already had the Storage emulator running before F-028, the gateway
# was renamed from `storage-gateway` to `supabase-gateway` (it now serves two
# APIs, not one) and the old container keeps the port 54321 unless you run,
# once:
#
#   docker compose up -d --remove-orphans
#
# Without it the symptom is "port is already allocated", which says nothing
# about the rename or the fix.
#
# In production these are the real project's values.
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Read by docker-compose.yml only: the secret the two keys above are signed
# with. The application never reads it.
STORAGE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="store-media"

# --- Integration with cuadrecaja --------------------------------------------
# F-018: the bearer token on /api/internal/* is PER BUSINESS now — there is
# no server-side variable for it anymore (the corte limpio of the old
# global token). Only its SHA-256 lives in Business.syncTokenHash.
#
# For local scripts and smokes only: the plaintext token of one development
# business (seed-negocio-1), acuñado con:
#   npm run mint:token -- seed-negocio-1
# Never reuse the name of the variable this replaces — that would resurrect,
# in your own .env, the exact "one global token" concept F-018 removes.
QAB_BEARER_TOKEN=""

# Shared secret cuadrecaja uses to sign one-time admin SSO tokens.
# Must match cuadrecaja's SSO_JWT_SECRET exactly.
SSO_JWT_SECRET=""

# Secret this app uses to sign its own admin session cookie. Independent of
# the one above — rotating it only logs admins out.
ADMIN_SESSION_SECRET=""

# --- Cron ------------------------------------------------------------------
# Vercel cron routes check this. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- App -------------------------------------------------------------------
# Absolute origin, used for sitemap, robots and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
