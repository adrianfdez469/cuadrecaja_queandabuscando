# =============================================================================
# queandabuscando — every variable the app reads is listed here.
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Database (Supabase project of queandabuscando, NOT cuadrecaja's) --------
# Pooled connection (Supavisor, transaction mode). Used by the app at runtime.
# Transaction mode means no query may run on the global client inside a
# $transaction — batch into a single round-trip instead.
# Local (docker compose up -d):
#   postgresql://postgres:postgres@localhost:5433/queandabuscando
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2"
# Direct connection. Used only by migrations and introspection (DDL cannot run
# through the pooler). Configured in prisma.config.ts.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase (shopper auth + image storage) --------------------------------
# Local (docker compose up -d): the Storage emulator, which speaks the real
# Supabase Storage API. Its credentials are NOT in this file and never should
# be — anything key-shaped committed here teaches the next person to paste a
# real key in the same slot. Generate your own, unique to your machine:
#
#   node scripts/storage-dev-keys.mjs --write
#   docker compose up -d --force-recreate storage storage-gateway
#
# That writes STORAGE_JWT_SECRET (read by the emulator, not by the app) plus the
# two keys below into .env, which is gitignored. `docker compose` reads the same
# file, so the app and the emulator agree without either value living in git.
#
# In production these are the real project's values.
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Read by docker-compose.yml only: the secret the two keys above are signed
# with. The application never reads it.
STORAGE_JWT_SECRET=""
SUPABASE_STORAGE_BUCKET="store-media"

# --- Integration with cuadrecaja --------------------------------------------
# Bearer token the POS sends on /api/internal/*. Long and random:
#   openssl rand -base64 48
# The same value must be set in cuadrecaja's environment.
SYNC_TOKEN=""

# Shared secret cuadrecaja uses to sign one-time admin SSO tokens.
# Must match cuadrecaja's SSO_JWT_SECRET exactly.
SSO_JWT_SECRET=""

# Secret this app uses to sign its own admin session cookie. Independent of
# the one above — rotating it only logs admins out.
ADMIN_SESSION_SECRET=""

# --- Cron ------------------------------------------------------------------
# Vercel cron routes check this. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- App -------------------------------------------------------------------
# Absolute origin, used for sitemap, robots and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
