// queandabuscando — online storefronts fed by the cuadrecaja POS.
//
// Money is Decimal(14,2), never Float. CUP is the universal currency anchor:
// ExchangeRate.rate is "CUP per 1 unit"; CUP itself is never stored as a rate.
//
// Postgres extensions (unaccent, pg_trgm) are created by SQL migration,
// not by Prisma. See prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StoreStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

/// Derived in cuadrecaja from stock + umbralBajo. The raw stock integer never
/// crosses the boundary, so this arrives as an opaque enum.
enum Availability {
  OUT_OF_STOCK
  LOW_STOCK
  AVAILABLE
}

enum CheckoutMode {
  WHATSAPP
  ONSITE
}

/// F-031. How this store's delivery fee gets decided. Read when an order is
/// CREATED (E14) and never re-read afterwards. Written by cuadrecaja through
/// the sync starting F-032; F-031 only reads it.
enum DeliveryFeeMode {
  FLAT_RATE
  QUOTED_PER_ORDER
}

enum OrderStatus {
  PENDING
  PULLED
  AWAITING_CUSTOMER
  CONFIRMED
  READY
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REJECTED_BY_STORE
}

/// Who closed the order. `cancelReason` stays the free-text human message;
/// this is what code can branch on (F-019 I4, R9).
enum OrderCancelledBy {
  CUSTOMER
  EXPIRY
  STORE
}

/// How the LAST proposal was resolved. Separate from `status` on purpose: the
/// POS can move the order along afterwards and the proposal's own history
/// must not get lost (F-019 architecture.md DA1).
enum ProposalOutcome {
  APPROVED
  REJECTED
  EXPIRED
}

enum PromotionType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  PRODUCT
  CATEGORY
  ORDER
}

enum SyncEntity {
  STORE
  CATEGORY
  PRODUCT
  CURRENCY
  EXCHANGE_RATE
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum SyncEventStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

/// F-017: what a row of `Slug` names. `RESERVED` has no owner at all — it
/// exists purely so a proposed slug that slips past validation still hits
/// the primary key. A row with `kind = STOREFRONT` and no `storefrontId`
/// is a RETIRED value (R13): its owner disappeared, and the value never
/// goes back into the pool.
enum SlugKind {
  STOREFRONT
  STORE
  RESERVED
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// Mirror of cuadrecaja's `Negocio`. Never holds credentials.
model Business {
  id               String   @id @default(uuid())
  externalId       String   @unique
  name             String
  /// F-017 (I1): retired. `handlers/store.ts` no longer generates it, and it
  /// never enters the `Slug` registry — a business named "La Rampa" would
  /// otherwise reserve `la-rampa` for a row that resolves no URL at all,
  /// taking it away from the brand that does.
  slug             String?  @unique
  logoUrl          String?
  baseCurrencyCode String   @default("CUP")
  /// SHA-256 of the bearer token this business uses on /api/internal/*.
  syncTokenHash    String?  @unique
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stores        Store[]
  storefronts   Storefront[]
  categories    LocalCategory[]
  aliases       ProductAlias[]
  exchangeRates ExchangeRate[]
  adminUsers    AdminUser[]
  orders        Order[]
  bellWindow    OrderBellWindow?

  @@index([active])
}

/// F-020 — the bell's coalescence window (architecture.md DA3). One row per
/// business, shared between ALL instances: that is what makes R10 a property
/// of the SYSTEM, not of a single process (I5). Written by ONE round-trip
/// statement each (src/features/orders/server/bell.ts), never inside a
/// `$transaction` — the pooler runs in transaction mode.
model OrderBellWindow {
  businessId      String    @id
  /// Start of the currently live window. The entry bell opens it; the close
  /// bell renews it, opening the NEXT window at the same instant (E8).
  windowStartedAt DateTime  @default(now())
  /// Non-null while there is at least one event inside the window that has
  /// not rung yet. Null once the close bell has fired for it.
  pendingSince    DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// F-017 — the brand a shopper's QR points at. Owns the public slug, the
/// branding and the panel's own contact columns. Lives only in
/// queandabuscando: the POS knows nothing about it, so no column here is
/// ever written by the sync except at creation (R5). No `status` (R6):
/// opening and closing to the public stays a `Store` concern, because the
/// POS's opt-in (`sourceOptIn`) is per `Tienda` — lifting the switch to the
/// brand would make one location's flip open or close every sibling. No
/// description either (R8): `Store.description` stays sync-owned.
model Storefront {
  id         String @id @default(uuid())
  businessId String
  name       String
  slug       String @unique

  // --- owned by the admin panel; the sync NEVER touches these except to
  // create the row the first time a branch of this brand publishes (R5) ---
  themeTokens     Json?
  logoUrl         String?
  coverUrl        String?
  contactPhone    String?
  contactWhatsapp String?
  contactEmail    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stores    Store[]
  slugEntry Slug?

  @@index([businessId])
}

/// F-017 — the single namespace of public first-level slugs. A value has AT
/// MOST one owner, enforced by the primary key plus the
/// `Slug_owner_matches_kind` CHECK written by hand in the migration (Prisma
/// has no `@@check`) — never by a `SELECT` in application code (criterio 4).
///
/// A value is never reassigned (R13): when its owner disappears the FK sets
/// the pointer to NULL and the row survives with `retiredAt`, so a printed
/// QR can never end up pointing at somebody else's business.
model Slug {
  value        String    @id
  kind         SlugKind
  storefrontId String?   @unique
  storeId      String?   @unique
  retiredAt    DateTime?
  createdAt    DateTime  @default(now())

  storefront Storefront? @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  store      Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
}

/// Mirror of a cuadrecaja `Tienda` the business opted into publishing.
/// The row existing IS the opt-in; `status` controls publication.
model Store {
  id           String      @id @default(uuid())
  businessId   String
  storefrontId String
  externalId   String      @unique
  /// F-017: nullable. Only a branch reached by its OWN first-level URL keeps
  /// a value here (a live alias from before the brand existed, or — etapa 2
  /// — one of several branches of the same brand). A brand's only branch has
  /// none: the brand's own slug is what resolves it.
  slug         String?     @unique
  name         String
  description  String?
  status       StoreStatus @default(DRAFT)

  phone    String?
  whatsapp String?
  email    String?

  address   String?
  city      String?
  province  String?
  /// Reserved for marketplace proximity search.
  ///
  /// Deliberately plain columns rather than a PostGIS geography: proximity
  /// search is not built yet, and requiring the postgis extension would mean
  /// every local database needs a postgis-enabled image. The coordinates are
  /// captured now; the geography column and its GiST index arrive in the
  /// migration that actually implements the search.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  openingHours Json?

  checkoutMode     CheckoutMode    @default(WHATSAPP)
  deliveryEnabled  Boolean         @default(false)
  deliveryFee      Decimal?        @db.Decimal(14, 2)
  /// F-031 DA2. FLAT_RATE reads `deliveryFee` above; QUOTED_PER_ORDER ignores
  /// it for a DELIVERY order (§ Casos límite "manda el modo") and leaves the
  /// order's own `deliveryFee` NULL until someone quotes it.
  deliveryFeeMode  DeliveryFeeMode @default(FLAT_RATE)
  /// F-019 R5/R20. Hours a proposal stays open before the clock cancels it.
  /// A queandabuscando-owned field: the sync never sends it and a STORE event
  /// never overwrites it (the sync handler writes an explicit column list).
  orderExpiryHours Int             @default(24)

  publishedAt DateTime?

  /// HD10-HD15: the public on/off switch, independent of `status`'s DRAFT vs
  /// PUBLISHED (the sync's own opt-in). Set by the panel's interruptor OR by
  /// the sync when it suspends a store; cleared together whenever the store
  /// republishes. `disabledReasonCode` is one of `STORE_DISABLED_REASONS`
  /// (`src/constants/storeClosure.ts`) when the panel closed it, or `null`
  /// when the sync did (the POS does not speak our reason vocabulary).
  disabledReasonCode String?
  disabledMessage    String?
  disabledAt         DateTime?

  /// HD10/AP6: the stale-write guard `StoreProduct` already has
  /// (`sourceUpdatedAt`), applied here so a re-delivered STORE event cannot
  /// resurrect a store the admin just closed by racing an older payload.
  sourceUpdatedAt DateTime?
  /// HD10/AP5(b): the POS's own `publishToStore` value, tracked separately
  /// from `status` so the handler can tell "the opt-in changed" from "some
  /// other field of the store changed" and only touch `status`/`disabled*`
  /// in the first case — otherwise editing a phone number in the POS would
  /// silently reopen a store the admin closed for vacation.
  sourceOptIn     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront    Storefront         @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  slugEntry     Slug?
  products      StoreProduct[]
  promotions    Promotion[]
  orders        Order[]
  adminAccess   AdminStoreAccess[]
  searchQueries StoreSearchQuery[]

  @@index([businessId])
  @@index([storefrontId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Catalog — canonical identity
// ---------------------------------------------------------------------------

/// Marketplace taxonomy, owned by the platform (not synced).
model GlobalCategory {
  id       String  @id @default(uuid())
  slug     String  @unique
  name     String
  parentId String?

  parent   GlobalCategory?  @relation("GlobalCategoryTree", fields: [parentId], references: [id])
  children GlobalCategory[] @relation("GlobalCategoryTree")

  canonicalProducts CanonicalProduct[]
  localCategories   LocalCategory[]

  @@index([parentId])
}

/// Mirror of cuadrecaja's `Categoria`, scoped to a business.
model LocalCategory {
  id               String    @id @default(uuid())
  businessId       String
  externalId       String
  name             String
  /// F-026: the slug is the identifier PUBLIC of the category in
  /// `/[slug]/c/[categorySlug]`. Unique per business and frozen on the first
  /// CREATE: renaming in the POS changes `name`, never this (R8/E7).
  slug             String
  color            String?
  globalCategoryId String?
  /// F-026 (I8): stale-write guard, same shape as `Store.sourceUpdatedAt`.
  /// Nullable because rows that already exist do not carry an origin mark:
  /// the first delivery after the migration sets it, and from there it stays
  /// protected.
  sourceUpdatedAt  DateTime?

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  globalCategory GlobalCategory? @relation(fields: [globalCategoryId], references: [id])
  products       StoreProduct[]

  @@unique([businessId, externalId])
  @@unique([businessId, slug])
  @@index([globalCategoryId])
}

/// Identity shared across businesses — the basis of the marketplace.
/// `isExclusive` marks an orphan canonical: visible in its own store,
/// excluded from the marketplace. This is what guarantees that a product
/// with neither EAN nor canonical id can still always be published.
model CanonicalProduct {
  id               String  @id @default(uuid())
  ean              String? @unique
  name             String
  description      String?
  imageUrl         String?
  globalCategoryId String?
  isExclusive      Boolean @default(false)

  /// Concatenated searchable text: name + every alias. Recomputed whenever a
  /// new alias appears — forgetting this silently degrades search.
  searchDocument String                   @default("")
  /// Populated by application code with to_tsvector('spanish', unaccent(...)).
  /// GIN index is created in the SQL migration.
  searchVector   Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  globalCategory GlobalCategory?    @relation(fields: [globalCategoryId], references: [id])
  aliases        ProductAlias[]
  storeProducts  StoreProduct[]
  barcodes       CanonicalBarcode[]

  @@index([globalCategoryId])
  @@index([isExclusive])
}

/// Every valid barcode of a canonical product (F-024). ADDITIVE: rows are
/// inserted and never deleted, not even when the POS stops sending a code —
/// no `businessId` here means a row does not say WHO contributed it, so
/// deleting on one business's behalf would delete another's (R6, ADR 0020).
/// `ean` is unique PER canonical, never globally: the same code living in two
/// canonicals is the fact the F-024 measurement exists to count (R7).
model CanonicalBarcode {
  id                 String   @id @default(uuid())
  canonicalProductId String
  /// Already normalized: digits only, length 8/12/13/14.
  ean                String
  createdAt          DateTime @default(now())

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)

  @@unique([canonicalProductId, ean])
  @@index([ean])
}

/// How each business names a canonical product. Feeds `searchDocument`.
model ProductAlias {
  id                 String @id @default(uuid())
  canonicalProductId String
  text               String
  businessId         String
  useCount           Int    @default(1)

  createdAt DateTime @default(now())

  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id], onDelete: Cascade)
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([canonicalProductId, text, businessId])
  @@index([businessId])
}

/// The concrete offer: what a shopper sees and buys.
/// Mirrors one row of cuadrecaja's `ProductoTienda`.
model StoreProduct {
  id                 String @id @default(uuid())
  storeId            String
  canonicalProductId String
  /// UUID of the source ProductoTienda row.
  externalId         String
  slug               String

  // --- owned by the sync; never edited here ---
  localName           String
  syncedPrice         Decimal      @db.Decimal(14, 2)
  syncedPriceCurrency String
  availability        Availability @default(AVAILABLE)
  localCategoryId     String?
  /// Payload timestamp of the write that produced this row. Every sync UPDATE
  /// carries `AND sourceUpdatedAt < $new`, which makes delivery order irrelevant.
  sourceUpdatedAt     DateTime
  syncedAt            DateTime     @default(now())
  deletedAt           DateTime?

  // --- owned by the admin panel; the sync never touches these ---
  description           String?
  imageUrls             String[] @default([])
  priceOverride         Decimal? @db.Decimal(14, 2)
  priceOverrideCurrency String?
  visible               Boolean  @default(true)
  featured              Boolean  @default(false)

  // --- derived search index (F-021): owned by NEITHER side ---
  /// Concatenated, ALREADY UNACCENTED searchable text:
  /// localName · this business's aliases for the canonical · description.
  /// Never written by the sync's or the panel's typed `data`: both of them
  /// call the reindexer, which recomputes it from the row's current state.
  /// That is what makes ADR 0007's ownership hold in both directions.
  searchDocument String                   @default("")
  /// Weighted tsvector: A = localName, B = aliases, C = description.
  /// Unsupported: written with raw SQL (ADR 0019). GIN index in the migration.
  searchVector   Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  canonicalProduct CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  localCategory    LocalCategory?   @relation(fields: [localCategoryId], references: [id])
  orderItems       OrderItem[]

  @@unique([storeId, canonicalProductId])
  @@unique([storeId, externalId])
  @@unique([storeId, slug])
  @@index([storeId, deletedAt, visible])
  @@index([canonicalProductId])
  @@index([localCategoryId])
}

/// F-021 (R4, R5): one row per search that reached the database. Three
/// columns and the instant, on purpose: no IP, no user agent, no person.
/// A query that never reached the database (E10) leaves nothing here.
/// Retention/anonymisation is deliberately out of this feature's scope.
model StoreSearchQuery {
  id          String   @id @default(uuid())
  storeId     String
  /// Already normalized (R9), never as it arrived.
  term        String
  /// Total of the three layers, not the page.
  resultCount Int
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

model Currency {
  code   String  @id
  name   String
  symbol String
  active Boolean @default(true)

  exchangeRates ExchangeRate[]
}

/// Append-only. `rate` is CUP per 1 unit of `currencyCode`; CUP is never stored.
model ExchangeRate {
  id           String   @id @default(uuid())
  businessId   String
  currencyCode String
  rate         Decimal  @db.Decimal(18, 6)
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyCode], references: [code])

  @@index([businessId, currencyCode, createdAt])
}

/// Lives only in queandabuscando. The POS knows nothing about promotions.
model Promotion {
  id         String         @id @default(uuid())
  storeId    String
  /// PP3: admin-only label, never shown to a shopper. Optional — the
  /// listing falls back to a derived label when empty (design.md § 5).
  name       String?
  type       PromotionType
  scope      PromotionScope
  value      Decimal        @db.Decimal(14, 2)
  conditions Json?
  startsAt   DateTime
  endsAt     DateTime?
  active     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active])
}

// ---------------------------------------------------------------------------
// Shoppers and orders
// ---------------------------------------------------------------------------

/// Optional. Guest checkout is the primary path; an account only persists
/// contact details and order history. Auth itself lives in Supabase.
model Customer {
  id             String  @id @default(uuid())
  supabaseUserId String? @unique
  name           String?
  phone          String?
  email          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]
}

model CustomerAddress {
  id         String  @id @default(uuid())
  customerId String
  label      String
  address    String
  notes      String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// BigInt autoincrement because the POS pages through orders with `?since=<id>`
/// and needs a monotonic cursor.
model Order {
  id   BigInt @id @default(autoincrement())
  code String @unique

  /// One per checkout attempt (R26). Nullable: a caller with no key gets no
  /// duplicate protection (R28) — Postgres does not count NULLs as colliding.
  idempotencyKey String? @unique

  storeId    String
  customerId String?
  /// Denormalized from Store.businessId (F-018): lets /api/internal/orders
  /// filter and index by tenant without a join. Backfilled from Store on
  /// migration; set at checkout in createOrder.ts.
  businessId String

  // Contact snapshot — a guest order must be self-sufficient.
  contactName     String
  contactPhone    String
  contactEmail    String?
  deliveryAddress String?

  status       OrderStatus       @default(PENDING)
  cancelReason String?
  /// R9, criterio 5. `null` while the order is not closed. Which of the
  /// three terminal outcomes closed it — the customer, the clock, or the
  /// store — separate from the free-text `cancelReason` above.
  cancelledBy  OrderCancelledBy?

  currencyCode  String
  subtotal      Decimal  @db.Decimal(14, 2)
  discountTotal Decimal  @default(0) @db.Decimal(14, 2)
  /// F-031 DA1. NULL = the delivery fee has not been quoted yet — never
  /// confused with a genuine `0.00` (R1). `@default(0)` keeps a writer that
  /// omits this column on today's behaviour: quoted, envío gratis. Only
  /// `createOrder.ts` writes NULL, for a QUOTED_PER_ORDER store's DELIVERY
  /// order (E2); approving a proposal (`respond.ts`) already overwrites it
  /// with `proposedDeliveryFee`, which closes the pending state with no new
  /// code (architecture.md DA1).
  deliveryFee   Decimal? @default(0) @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)
  /// Exchange rates frozen at order time. Historical prices are never recomputed.
  rateSnapshot  Json

  // --- Renegotiation (F-019 architecture.md DA1). All nullable: the store's
  // proposal lives in the order's own row rather than a separate table, and
  // only ever has values while a proposal is live or was the last one
  // resolved. See architecture.md § "Modelo de datos y migraciones".
  /// R5/R7. Frozen when proposed and never cleared afterwards.
  expiresAt             DateTime?
  /// When the current/last proposal was made (E13 restarts the clock).
  proposedAt            DateTime?
  /// The store's message to the customer (E2). ≤500 chars, enforced in Zod.
  proposalMessage       String?
  /// R3. The "previous total" the customer sees — the totals in effect right
  /// before this proposal replaced them.
  previousTotal         Decimal?         @db.Decimal(14, 2)
  proposedSubtotal      Decimal?         @db.Decimal(14, 2)
  proposedDiscountTotal Decimal?         @db.Decimal(14, 2)
  proposedDeliveryFee   Decimal?         @db.Decimal(14, 2)
  proposedTotal         Decimal?         @db.Decimal(14, 2)
  /// The proposed lines, amounts as strings (same convention as
  /// rateSnapshot). Deliberately NOT selected in the pull (DA5).
  proposedItems         Json?
  /// Decides E7's 200-idempotent vs 409 rule (DA4).
  proposalOutcome       ProposalOutcome?
  /// When the last proposal was decided (approved/rejected/expired).
  proposalDecidedAt     DateTime?

  notes    String?
  pulledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id])
  business Business    @relation(fields: [businessId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([storeId, createdAt])
  @@index([status, id])
  @@index([customerId])
  @@index([businessId, status, id])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId BigInt

  /// Nullable: the product may be soft-deleted later; the snapshot below stands.
  storeProductId String?
  name           String
  unitPrice      Decimal @db.Decimal(14, 2)
  currencyCode   String
  quantity       Decimal @db.Decimal(14, 3)
  lineTotal      Decimal @db.Decimal(14, 2)

  /// Effective price BEFORE converting to the order's currency (R5).
  /// Informative only — never sumable, never used for any total (R5b).
  originalUnitPrice    Decimal? @db.Decimal(14, 2)
  originalCurrencyCode String?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct? @relation(fields: [storeProductId], references: [id])

  @@index([orderId])
  @@index([storeProductId])
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// Mirror of a cuadrecaja `Usuario`. Deliberately has NO password field:
/// credentials are never replicated. Access arrives signed in the SSO token.
model AdminUser {
  id          String    @id @default(uuid())
  externalId  String    @unique
  businessId  String?
  name        String
  email       String?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business?          @relation(fields: [businessId], references: [id])
  storeAccess AdminStoreAccess[]

  @@index([businessId])
}

model AdminStoreAccess {
  id          String @id @default(uuid())
  adminUserId String
  storeId     String

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, storeId])
  @@index([storeId])
}

/// Enforces the single use of an SSO token. Purged by cron.
model SsoTokenUse {
  jti       String   @id
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Sync inbox
// ---------------------------------------------------------------------------

/// Inbox pattern. Idempotency is by `eventId` (the id of the row in
/// cuadrecaja's OutboxEvento), which makes replaying a whole batch safe.
model SyncEvent {
  id          String          @id @default(uuid())
  eventId     String          @unique
  businessId  String
  entity      SyncEntity
  operation   SyncOperation
  occurredAt  DateTime
  payload     Json
  status      SyncEventStatus @default(PENDING)
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  error       String?

  @@index([status, receivedAt])
  @@index([businessId])
}
