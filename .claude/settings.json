{
  "permissions": {
    "allow": [
      "Bash(bash .agent/init.sh:*)",
      "Bash(bash .agent/sdd.sh:*)",
      "Bash(bash .agent/verify.sh:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run check:theme)",
      "Bash(npm run check:bundle)",
      "Bash(npx prisma validate)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-contract-version.sh\"",
            "statusMessage": "Comprobando la versión del contrato"
          }
        ]
      }
    ]
  }
}
